{
  "name": "shortsmith",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ByteByteGo-style vertical short generator (YouTube Shorts / IG Reels)",
  "scripts": {
    "studio": "remotion studio",
    "render": "node scripts/render-reels.mjs",
    "voice": "node scripts/tts.mjs",
    "build": "node scripts/build-reels.mjs",
    "lint": "node scripts/lint-reels.mjs",
    "lint:strict": "node scripts/lint-reels.mjs --strict",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.410",
    "@remotion/cli": "4.0.410",
    "@remotion/google-fonts": "4.0.410",
    "@remotion/media-utils": "4.0.410",
    "@remotion/paths": "4.0.410",
    "@remotion/renderer": "4.0.410",
    "@remotion/shapes": "4.0.410",
    "@remotion/transitions": "4.0.410",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.410"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.7.3"
  }
}
