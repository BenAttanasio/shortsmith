# Google AI Studio key (https://aistudio.google.com/apikey)
# Used for Gemini 2.5 TTS voice generation.
GOOGLE_API_KEY=your_key_here

# Auphonic key (https://auphonic.com/engine/account/)
# Used to master narration to a consistent loudness. Optional — renders work without it.
AUPHONIC_API_KEY=your_key_here

# RunPod key (Console -> Settings -> API Keys)
# Used by scripts/render-remote.mjs to create, drive and destroy a render pod.
# Optional — scripts/render-reels.mjs renders locally without it.
RUNPOD_API_KEY=your_key_here
